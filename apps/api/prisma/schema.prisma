// Prisma 7 generates a TypeScript client into the application source tree.
// The generated folder is git-ignored, so `prisma generate` runs as part of
// `pnpm dev`, `pnpm build` and `pnpm typecheck`.
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum FileStatus {
  PENDING
  UPLOADED
  FAILED
}

/// One row per object in the S3 bucket. A row is created as PENDING when the
/// presigned upload URL is issued and only becomes UPLOADED once the API has
/// confirmed the object actually exists in the bucket.
model FileObject {
  id                     String                  @id @default(cuid())
  originalName           String
  storageKey             String                  @unique
  mimeType               String
  size                   Int
  status                 FileStatus              @default(PENDING)
  uploadedAt             DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  driverDocument         DriverDocument?
  absenceAttestation     DriverAbsenceAttestation?
  vehicleInspection      VehicleInspection?
  tachographCalibration  TachographCalibration?
  vehicleSafetyEquipment VehicleSafetyEquipment?
  vehicleDocument        VehicleDocument?

  @@index([status])
  @@index([createdAt])
  @@index([status, createdAt])
}

enum DriverStatus {
  ACTIVE
  SICK_LEAVE
  VACATION
  INACTIVE
}

/// A driver employed by the company. Field names are English; the admin UI
/// presents Serbian labels.
model Driver {
  id                     String           @id @default(cuid())
  firstName              String
  lastName               String
  jmbg                   String           @unique
  dateOfBirth            DateTime         @db.Date
  residencePlace         String
  educationLevel         String
  idCardNumber           String
  drivingLicenseNumber   String
  drivingLicenseCategory String
  licenseNumber          String
  phone                  String
  email                  String
  jobTitle               String
  status                 DriverStatus     @default(ACTIVE)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  documents              DriverDocument[]
  absenceAttestations    DriverAbsenceAttestation[]
  fuelLogs               FuelLog[]
  transactions           FinanceTransaction[]

  @@index([status])
  @@index([lastName, firstName])
  @@map("drivers")
}

enum DriverDocumentType {
  EMPLOYMENT_CONTRACT
  MA_FORM
  MEDICAL_CERTIFICATE
  ACCREDITATION
  DRIVING_LICENSE
  LICENSE
}

enum EmploymentContractType {
  FIXED_TERM
  INDEFINITE
}

/// A scanned driver document with optional validity dates. Field names are
/// English; the admin UI presents Serbian labels.
model DriverDocument {
  id                     String                  @id @default(cuid())
  driverId               String
  type                   DriverDocumentType
  documentNumber         String
  issuedAt               DateTime                @db.Date
  expiresAt              DateTime?               @db.Date
  employmentContractType EmploymentContractType?
  fileId                 String?                 @unique
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  driver Driver      @relation(fields: [driverId], references: [id], onDelete: Cascade)
  file   FileObject? @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([driverId])
  @@index([expiresAt])
  @@index([type])
  @@map("driver_documents")
}

enum AbsenceReason {
  SICK_LEAVE
  ANNUAL_LEAVE
  LEAVE_OR_REST
  OTHER
}

/// A generated AETR / EC 561/2006 attestation that the driver did not drive
/// during a given period. Kept separate from scanned driver_documents.
model DriverAbsenceAttestation {
  id            String         @id @default(cuid())
  driverId      String
  periodFrom    DateTime
  periodTo      DateTime
  reason        AbsenceReason
  otherReason   String?
  place         String
  issuedAt      DateTime       @db.Date
  startedWorkAt DateTime       @db.Date
  fileId        String         @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  driver Driver     @relation(fields: [driverId], references: [id], onDelete: Cascade)
  file   FileObject @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@index([driverId])
  @@index([periodFrom])
  @@map("driver_absence_attestations")
}

/// Bootstrap admin accounts. Passwords are stored as bcrypt hashes and never
/// returned by the API.
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum VehicleType {
  BUS
  VAN
  MIDIBUS
}

enum VehicleFuelType {
  DIESEL
  PETROL
  LPG
  CNG
  ELECTRIC
  HYBRID
}

enum TachographType {
  ANALOG
  DIGITAL
}

enum VehicleStatus {
  ACTIVE
  IN_SERVICE
  OUT_OF_SERVICE
}

/// A vehicle in the fleet (bus, van, midibus). Field names are English; the
/// admin UI presents Serbian labels. Other vehicle modules (inspections,
/// tachograph calibration, safety equipment, fuel, maintenance, documents)
/// attach to this model as they are built.
model Vehicle {
  id             String          @id @default(cuid())
  make           String
  model          String
  year           Int
  licensePlate   String          @unique
  vin            String          @unique
  seatCount      Int
  type           VehicleType
  fuelType       VehicleFuelType
  tachographType TachographType
  status         VehicleStatus   @default(ACTIVE)
  currentMileage Int
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  inspections     VehicleInspection[]
  calibrations    TachographCalibration[]
  safetyEquipment VehicleSafetyEquipment[]
  fuelLogs        FuelLog[]
  maintenance     VehicleMaintenance[]
  documents       VehicleDocument[]
  transactions    FinanceTransaction[]

  @@index([status])
  @@index([type])
  @@index([make, model])
  @@map("vehicles")
}

enum VehicleInspectionType {
  REGULAR
  SEMI_ANNUAL
  MONTHLY
}

/// A technical inspection record for a vehicle. `expiresAt` is always computed
/// server-side from `type` + `inspectedAt`; it is never trusted from the client.
model VehicleInspection {
  id          String                @id @default(cuid())
  vehicleId   String
  type        VehicleInspectionType
  inspectedAt DateTime              @db.Date
  expiresAt   DateTime              @db.Date
  cost        Float?
  paymentMethod PaymentMethod?
  fileId      String?               @unique
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  vehicle Vehicle     @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  file    FileObject? @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([vehicleId])
  @@index([expiresAt])
  @@index([type])
  @@map("vehicle_inspections")
}

/// A tachograph calibration record. `expiresAt` is always computed
/// server-side from the vehicle's `tachographType` + `calibratedAt`.
model TachographCalibration {
  id           String   @id @default(cuid())
  vehicleId    String
  calibratedAt DateTime @db.Date
  expiresAt    DateTime @db.Date
  cost         Float?
  paymentMethod PaymentMethod?
  fileId       String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  vehicle Vehicle     @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  file    FileObject? @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([vehicleId])
  @@index([expiresAt])
  @@map("tachograph_calibrations")
}

enum SafetyEquipmentType {
  FIRST_AID_KIT
  FIRE_EXTINGUISHER
}

/// PP aparat (fire extinguisher) checks and prva pomoć (first aid kit) box
/// expiries. `expiresAt` is computed server-side for FIRE_EXTINGUISHER
/// (+180 days) and entered manually for FIRST_AID_KIT (printed on the box).
model VehicleSafetyEquipment {
  id        String              @id @default(cuid())
  vehicleId String
  type      SafetyEquipmentType
  checkedAt DateTime            @db.Date
  expiresAt DateTime            @db.Date
  cost      Float?
  paymentMethod PaymentMethod?
  fileId    String?             @unique
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  vehicle Vehicle     @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  file    FileObject? @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([vehicleId])
  @@index([expiresAt])
  @@index([type])
  @@map("vehicle_safety_equipment")
}

enum FuelLogFuelType {
  DIESEL
  ADBLUE
}

/// A fuel/AdBlue fill-up. `kmDriven` and `consumptionPer100Km` are computed
/// server-side at write time from `odometerKm` and the vehicle's closest
/// earlier reading (any fuel type) — never trusted from the client, and never
/// recomputed retroactively when an earlier log changes.
model FuelLog {
  id                  String          @id @default(cuid())
  vehicleId           String
  fueledAt            DateTime        @db.Date
  location            String
  driverId            String?
  fuelType            FuelLogFuelType
  litersFilled        Float
  odometerKm          Int
  cost                Float?
  paymentMethod       PaymentMethod?
  supplier            String?
  kmDriven            Int?
  consumptionPer100Km Float?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driver  Driver? @relation(fields: [driverId], references: [id], onDelete: SetNull)

  @@index([vehicleId])
  @@index([vehicleId, odometerKm])
  @@index([fueledAt])
  @@index([fuelType])
  @@index([driverId, fueledAt])
  @@map("fuel_logs")
}

/// A part replacement / maintenance record for a vehicle.
model VehicleMaintenance {
  id         String   @id @default(cuid())
  vehicleId  String
  date       DateTime @db.Date
  odometerKm Int
  partName   String
  supplier   String
  cost       Float
  paymentMethod PaymentMethod @default(ACCOUNT)
  mechanic   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([date])
  @@index([supplier])
  @@map("vehicle_maintenance")
}

enum VehicleDocumentType {
  REGISTRATION
}

/// A scanned/photographed vehicle document not tied to a specific expiring
/// record (currently just the registration certificate — "saobraćajna
/// dozvola"). Other document types can be added to the enum later.
model VehicleDocument {
  id        String              @id @default(cuid())
  vehicleId String
  type      VehicleDocumentType
  issuedAt  DateTime?           @db.Date
  fileId    String?             @unique
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  vehicle Vehicle     @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  file    FileObject? @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([vehicleId])
  @@index([type])
  @@map("vehicle_documents")
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionCategory {
  CONTRACT
  FUEL
  PARTS
  TECHNICAL_INSPECTION
  TACHOGRAPH
  FIRE_EXTINGUISHER
  SALARY
  OTHER
}

enum PaymentMethod {
  ACCOUNT
  CASH
}

enum TransactionStatus {
  OPEN
  SETTLED
}

enum TransactionSourceType {
  MANUAL
  FUEL_LOG
  MAINTENANCE
  INSPECTION
  CALIBRATION
  SAFETY_EQUIPMENT
}

/// A bookkeeping row. Field names are English; the admin UI presents Serbian
/// labels. Auto-generated rows are keyed by `sourceType` + `sourceId` so an
/// operational create/update/delete stays in sync. `contractId` is stored as a
/// plain id until a transport-contract module exists — there is no FK yet.
model FinanceTransaction {
  id                  String                @id @default(cuid())
  type                TransactionType
  category            TransactionCategory
  amount              Float
  occurredAt          DateTime              @db.Date
  paymentMethod       PaymentMethod
  note                String?
  supplier            String?
  partner             String?
  route               String?
  vehicleId           String?
  driverId            String?
  contractId          String?
  isAdvance           Boolean               @default(false)
  status              TransactionStatus     @default(OPEN)
  linkedTransactionId String?
  sourceType          TransactionSourceType @default(MANUAL)
  sourceId            String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  vehicle          Vehicle?            @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driver           Driver?             @relation(fields: [driverId], references: [id], onDelete: SetNull)
  linkedTransaction FinanceTransaction? @relation("AdvanceSettlement", fields: [linkedTransactionId], references: [id], onDelete: SetNull)
  linkedAdvances   FinanceTransaction[] @relation("AdvanceSettlement")

  @@index([occurredAt])
  @@index([type])
  @@index([category])
  @@index([paymentMethod])
  @@index([vehicleId])
  @@index([driverId])
  @@index([supplier, isAdvance, status])
  @@index([partner])
  @@index([route])
  @@index([sourceType, sourceId])
  @@map("transactions")
}

/// Per-document red/yellow warning windows for the alarm center.
model AlarmThreshold {
  kind         String   @id
  criticalDays Int
  warningDays  Int
  updatedAt    DateTime @updatedAt

  @@map("alarm_thresholds")
}
