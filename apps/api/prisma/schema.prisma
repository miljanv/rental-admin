// Prisma 7 generates a TypeScript client into the application source tree.
// The generated folder is git-ignored, so `prisma generate` runs as part of
// `pnpm dev`, `pnpm build` and `pnpm typecheck`.
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum FileStatus {
  PENDING
  UPLOADED
  FAILED
}

/// One row per object in the S3 bucket. A row is created as PENDING when the
/// presigned upload URL is issued and only becomes UPLOADED once the API has
/// confirmed the object actually exists in the bucket.
model FileObject {
  id                     String                    @id @default(cuid())
  originalName           String
  storageKey             String                    @unique
  mimeType               String
  size                   Int
  status                 FileStatus                @default(PENDING)
  uploadedAt             DateTime?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  driverDocument         DriverDocument?
  absenceAttestation     DriverAbsenceAttestation?
  vehicleInspection      VehicleInspection?
  tachographCalibration  TachographCalibration?
  vehicleSafetyEquipment VehicleSafetyEquipment?
  vehicleDocument        VehicleDocument?
  contractDocument       ContractDocument?
  travelPermit           TravelPermit?

  @@index([status])
  @@index([createdAt])
  @@index([status, createdAt])
}

enum DriverStatus {
  ACTIVE
  SICK_LEAVE
  VACATION
  INACTIVE
}

/// A driver employed by the company. Field names are English; the admin UI
/// presents Serbian labels.
model Driver {
  id                     String                     @id @default(cuid())
  firstName              String
  lastName               String
  jmbg                   String                     @unique
  dateOfBirth            DateTime                   @db.Date
  residencePlace         String
  /// Street and house number — captured once here so the employment
  /// contract / MA form generators can auto-fill it instead of asking
  /// every single time (residencePlace alone already does this for town).
  residenceAddress       String?
  educationLevel         String
  idCardNumber           String
  drivingLicenseNumber   String
  drivingLicenseCategory String
  licenseNumber          String
  phone                  String
  email                  String?
  jobTitle               String
  status                 DriverStatus               @default(ACTIVE)
  /// Actually employed vs. nominally employed for tax/paperwork purposes —
  /// see EmploymentType. Drives generated-document naming and how often
  /// those documents realistically get regenerated.
  employmentType         EmploymentType             @default(ACTUAL)
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  documents              DriverDocument[]
  absenceAttestations    DriverAbsenceAttestation[]
  fuelLogs               FuelLog[]
  contracts              Contract[]
  transactions           FinanceTransaction[]
  tripAssignments        TripDriver[]

  @@index([status])
  @@index([lastName, firstName])
  @@map("drivers")
}

enum DriverDocumentType {
  EMPLOYMENT_CONTRACT
  MA_FORM
  MEDICAL_CERTIFICATE
  ACCREDITATION
  DRIVING_LICENSE
  LICENSE
}

enum EmploymentContractType {
  FIXED_TERM
  INDEFINITE
}

/// ACTUAL: genuinely employed, paperwork rarely changes. NOMINAL: employed
/// on paper only for a specific trip/engagement — new documents almost
/// every time they go out.
enum EmploymentType {
  ACTUAL
  NOMINAL
}

/// A scanned driver document with optional validity dates. Field names are
/// English; the admin UI presents Serbian labels.
model DriverDocument {
  id                     String                  @id @default(cuid())
  driverId               String
  type                   DriverDocumentType
  documentNumber         String
  issuedAt               DateTime                @db.Date
  expiresAt              DateTime?               @db.Date
  employmentContractType EmploymentContractType?
  fileId                 String?                 @unique
  /// The exact form payload last used to generate this document (Ugovor o
  /// radu / Obrazac MA only) — lets the "izmeni" flow reopen the generator
  /// pre-filled instead of starting from a blank form. Null for scanned
  /// document types, which have no generator.
  generationData         Json?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  driver Driver      @relation(fields: [driverId], references: [id], onDelete: Cascade)
  file   FileObject? @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([driverId])
  @@index([expiresAt])
  @@index([type])
  @@map("driver_documents")
}

enum AbsenceReason {
  SICK_LEAVE
  ANNUAL_LEAVE
  LEAVE_OR_REST
  OTHER
}

/// A generated AETR / EC 561/2006 attestation that the driver did not drive
/// during a given period. Kept separate from scanned driver_documents.
model DriverAbsenceAttestation {
  id            String        @id @default(cuid())
  driverId      String
  periodFrom    DateTime
  periodTo      DateTime
  reason        AbsenceReason
  otherReason   String?
  place         String
  issuedAt      DateTime      @db.Date
  startedWorkAt DateTime      @db.Date
  fileId        String        @unique
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  driver Driver     @relation(fields: [driverId], references: [id], onDelete: Cascade)
  file   FileObject @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@index([driverId])
  @@index([periodFrom])
  @@map("driver_absence_attestations")
}

/// Bootstrap admin accounts. Passwords are stored as bcrypt hashes and never
/// returned by the API.
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum VehicleType {
  BUS
  VAN
  MIDIBUS
  CAR
}

enum VehicleFuelType {
  DIESEL
  PETROL
  LPG
  CNG
  ELECTRIC
  HYBRID
}

enum TachographType {
  ANALOG
  DIGITAL
}

enum VehicleStatus {
  ACTIVE
  IN_SERVICE
  OUT_OF_SERVICE
}

/// A vehicle in the fleet (bus, van, midibus). Field names are English; the
/// admin UI presents Serbian labels. Other vehicle modules (inspections,
/// tachograph calibration, safety equipment, fuel, maintenance, documents)
/// attach to this model as they are built.
model Vehicle {
  id                 String          @id @default(cuid())
  make               String
  model              String
  year               Int
  licensePlate       String          @unique
  vin                String          @unique
  engineNumber       String?
  enginePower        Float?
  engineDisplacement Int?
  mass               Float?
  seatCount          Int
  standingCapacity   Int?
  type               VehicleType
  fuelType           VehicleFuelType
  tachographType     TachographType
  status             VehicleStatus   @default(ACTIVE)
  /// Odometer reading at the moment the vehicle entered the fleet — set once
  /// at creation and never changed again. The baseline for "km driven since
  /// intake" statistics; `currentMileage` is the one that moves.
  initialMileageKm   Int
  currentMileage     Int
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  inspections     VehicleInspection[]
  calibrations    TachographCalibration[]
  safetyEquipment VehicleSafetyEquipment[]
  fuelLogs        FuelLog[]
  maintenance     VehicleMaintenance[]
  documents       VehicleDocument[]
  contracts       Contract[]
  transactions    FinanceTransaction[]
  tripAssignments TripVehicle[]

  @@index([status])
  @@index([type])
  @@index([make, model])
  @@map("vehicles")
}

enum VehicleInspectionType {
  REGULAR
  SEMI_ANNUAL
  MONTHLY
}

/// A technical inspection record for a vehicle. `expiresAt` is always computed
/// server-side from `type` + `inspectedAt`; it is never trusted from the client.
model VehicleInspection {
  id            String                @id @default(cuid())
  vehicleId     String
  type          VehicleInspectionType
  inspectedAt   DateTime              @db.Date
  expiresAt     DateTime              @db.Date
  cost          Float?
  paymentMethod PaymentMethod?
  fileId        String?               @unique
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  vehicle Vehicle     @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  file    FileObject? @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([vehicleId])
  @@index([expiresAt])
  @@index([type])
  @@map("vehicle_inspections")
}

/// A tachograph calibration record. `expiresAt` is always computed
/// server-side from the vehicle's `tachographType` + `calibratedAt`.
model TachographCalibration {
  id            String         @id @default(cuid())
  vehicleId     String
  calibratedAt  DateTime       @db.Date
  expiresAt     DateTime       @db.Date
  cost          Float?
  paymentMethod PaymentMethod?
  fileId        String?        @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  vehicle Vehicle     @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  file    FileObject? @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([vehicleId])
  @@index([expiresAt])
  @@map("tachograph_calibrations")
}

enum SafetyEquipmentType {
  FIRST_AID_KIT
  FIRE_EXTINGUISHER
}

/// PP aparat (fire extinguisher) checks and prva pomoć (first aid kit) box
/// expiries. `expiresAt` is computed server-side for FIRE_EXTINGUISHER
/// (+180 days) and entered manually for FIRST_AID_KIT (printed on the box).
model VehicleSafetyEquipment {
  id            String              @id @default(cuid())
  vehicleId     String
  type          SafetyEquipmentType
  checkedAt     DateTime            @db.Date
  expiresAt     DateTime            @db.Date
  cost          Float?
  paymentMethod PaymentMethod?
  fileId        String?             @unique
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  vehicle Vehicle     @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  file    FileObject? @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([vehicleId])
  @@index([expiresAt])
  @@index([type])
  @@map("vehicle_safety_equipment")
}

enum FuelLogFuelType {
  DIESEL
  ADBLUE
}

/// A fuel/AdBlue fill-up. `kmDriven` and `consumptionPer100Km` are computed
/// server-side at write time from `odometerKm` and the vehicle's closest
/// earlier reading (any fuel type) — never trusted from the client, and never
/// recomputed retroactively when an earlier log changes.
model FuelLog {
  id                  String          @id @default(cuid())
  vehicleId           String
  fueledAt            DateTime        @db.Date
  location            String
  driverId            String?
  fuelType            FuelLogFuelType
  litersFilled        Float
  odometerKm          Int
  cost                Float?
  paymentMethod       PaymentMethod?
  supplier            String?
  kmDriven            Int?
  consumptionPer100Km Float?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driver  Driver? @relation(fields: [driverId], references: [id], onDelete: SetNull)

  @@index([vehicleId])
  @@index([vehicleId, odometerKm])
  @@index([fueledAt])
  @@index([fuelType])
  @@index([driverId, fueledAt])
  @@map("fuel_logs")
}

/// A part replacement / maintenance record for a vehicle.
model VehicleMaintenance {
  id            String        @id @default(cuid())
  vehicleId     String
  date          DateTime      @db.Date
  odometerKm    Int
  partName      String
  supplier      String
  cost          Float
  paymentMethod PaymentMethod @default(ACCOUNT)
  mechanic      String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([date])
  @@index([supplier])
  @@map("vehicle_maintenance")
}

enum VehicleDocumentType {
  REGISTRATION
}

/// A scanned/photographed vehicle document not tied to a specific expiring
/// record (currently just the registration certificate — "saobraćajna
/// dozvola"). Other document types can be added to the enum later.
model VehicleDocument {
  id        String              @id @default(cuid())
  vehicleId String
  type      VehicleDocumentType
  issuedAt  DateTime?           @db.Date
  fileId    String?             @unique
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  vehicle Vehicle     @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  file    FileObject? @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([vehicleId])
  @@index([type])
  @@map("vehicle_documents")
}

enum PartnerType {
  TRAVEL_AGENCY
  SPORTS_CLUB
  CULTURAL_ARTS_SOCIETY
  BUS_OPERATOR
  FACTORY
  INDIVIDUAL
  SCHOOL
  HOTEL
  MUNICIPALITY
  OTHER
}

/// A repeat client the company contracts with (travel agency, sports club,
/// KUD, individual, or other). Field names are English; the admin UI presents
/// Serbian labels. Contracts snapshot this identity at signing time instead
/// of joining live — see Contract's client* fields.
model Partner {
  id                 String      @id @default(cuid())
  type               PartnerType
  companyName        String?
  firstName          String?
  lastName           String?
  /// Street and house number — `city` holds the town separately.
  address            String
  city               String
  /// Common/informal name the office actually recognizes the partner by
  /// (e.g. legal name "PIP DOO" but everyone says "Tortilje") — optional,
  /// searchable.
  nickname           String?
  pib                String?
  registrationNumber String?
  personalId         String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  contracts Contract[]
  trips     Trip[]

  @@index([type])
  @@map("partners")
}

enum ContractStatus {
  DRAFT
  SIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/// A passenger transport contract ("ugovor o prevozu putnika"). `client*`
/// fields are a point-in-time copy of the partner's identity at signing —
/// deliberately duplicated so an already-signed contract never silently
/// changes if the partner's own record is edited later.
model Contract {
  id                       String         @id @default(cuid())
  partnerId                String
  vehicleId                String?
  driverId                 String?
  conclusionDate           DateTime       @db.Date
  route                    String
  serviceStartDate         DateTime       @db.Date
  serviceEndDate           DateTime       @db.Date
  passengerCount           Int
  price                    Float
  advancePercentage        Int
  status                   ContractStatus @default(DRAFT)
  notes                    String?
  /// Drives the passenger-list-type suggestion and whether the travel-permit
  /// section (and its "IN_PROGRESS" gate) applies at all — set explicitly by
  /// the user, since the free-text `route` can't be parsed reliably.
  isInternational          Boolean        @default(false)
  clientType               PartnerType
  clientCompanyName        String?
  clientFirstName          String?
  clientLastName           String?
  clientAddress            String
  clientPib                String?
  clientRegistrationNumber String?
  clientPersonalId         String?
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  partner        Partner            @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  vehicle        Vehicle?           @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driver         Driver?            @relation(fields: [driverId], references: [id], onDelete: SetNull)
  documents      ContractDocument[]
  passengerLists PassengerList[]
  travelPermits  TravelPermit[]
  trips          Trip[]

  @@index([partnerId])
  @@index([vehicleId])
  @@index([driverId])
  @@index([status])
  @@index([conclusionDate])
  @@map("contracts")
}

enum PassengerListType {
  DOMESTIC
  INTERNATIONAL
}

/// "Bela lista" (domestic) or "zelena lista" (international) in Serbian
/// passenger-transport terminology — one list per contract per type.
model PassengerList {
  id         String            @id @default(cuid())
  contractId String
  type       PassengerListType
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  contract   Contract    @relation(fields: [contractId], references: [id], onDelete: Cascade)
  passengers Passenger[]

  @@unique([contractId, type])
  @@index([contractId])
  @@map("passenger_lists")
}

model Passenger {
  id              String   @id @default(cuid())
  passengerListId String
  firstName       String
  lastName        String
  documentNumber  String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  passengerList PassengerList @relation(fields: [passengerListId], references: [id], onDelete: Cascade)

  @@index([passengerListId])
  @@map("passengers")
}

/// One row per country a contract needs a border-crossing permit for.
model TravelPermit {
  id           String   @id @default(cuid())
  contractId   String
  country      String
  permitNumber String
  issuedAt     DateTime @db.Date
  fileId       String   @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  contract Contract   @relation(fields: [contractId], references: [id], onDelete: Cascade)
  file     FileObject @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@index([contractId])
  @@map("travel_permits")
}

/// One row per generated contract PDF. Rows are immutable and accumulate —
/// regenerating a contract creates a new row with the next `version` rather
/// than overwriting, which is the "istorija verzija" (version history) the
/// task calls for.
model ContractDocument {
  id          String   @id @default(cuid())
  contractId  String
  version     Int
  fileId      String   @unique
  generatedAt DateTime @default(now())

  contract Contract   @relation(fields: [contractId], references: [id], onDelete: Cascade)
  file     FileObject @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@unique([contractId, version])
  @@index([contractId])
  @@map("contract_documents")
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionCategory {
  CONTRACT
  FUEL
  PARTS
  TECHNICAL_INSPECTION
  TACHOGRAPH
  FIRE_EXTINGUISHER
  SALARY
  OTHER
}

enum PaymentMethod {
  ACCOUNT
  CASH
}

enum TransactionStatus {
  OPEN
  SETTLED
}

enum TransactionSourceType {
  MANUAL
  FUEL_LOG
  MAINTENANCE
  INSPECTION
  CALIBRATION
  SAFETY_EQUIPMENT
}

/// A bookkeeping row. Field names are English; the admin UI presents Serbian
/// labels. Auto-generated rows are keyed by `sourceType` + `sourceId` so an
/// operational create/update/delete stays in sync. `contractId` is stored as a
/// plain id until a transport-contract module exists — there is no FK yet.
model FinanceTransaction {
  id                  String                @id @default(cuid())
  type                TransactionType
  category            TransactionCategory
  amount              Float
  occurredAt          DateTime              @db.Date
  paymentMethod       PaymentMethod
  note                String?
  supplier            String?
  partner             String?
  route               String?
  vehicleId           String?
  driverId            String?
  contractId          String?
  isAdvance           Boolean               @default(false)
  status              TransactionStatus     @default(OPEN)
  linkedTransactionId String?
  sourceType          TransactionSourceType @default(MANUAL)
  sourceId            String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  vehicle           Vehicle?             @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driver            Driver?              @relation(fields: [driverId], references: [id], onDelete: SetNull)
  linkedTransaction FinanceTransaction?  @relation("AdvanceSettlement", fields: [linkedTransactionId], references: [id], onDelete: SetNull)
  linkedAdvances    FinanceTransaction[] @relation("AdvanceSettlement")

  @@index([occurredAt])
  @@index([type])
  @@index([category])
  @@index([paymentMethod])
  @@index([vehicleId])
  @@index([driverId])
  @@index([supplier, isAdvance, status])
  @@index([partner])
  @@index([route])
  @@index([sourceType, sourceId])
  @@map("transactions")
}

/// Per-document red/yellow warning windows for the alarm center.
model AlarmThreshold {
  kind         String   @id
  criticalDays Int
  warningDays  Int
  updatedAt    DateTime @updatedAt

  @@map("alarm_thresholds")
}

enum TripStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  FREE
}

enum TripSeriesFrequency {
  DAILY
  WEEKLY
}

/// A recurring-trip template ("COKA - OS Coka svaki radni dan") that generates
/// concrete Trip rows over [startDate, endDate]. Kept after generation so the
/// whole run can be bulk-edited from a date onward or terminated early — see
/// Trip.seriesId and the trip-series bulk-update/terminate endpoints.
model TripSeries {
  id           String              @id @default(cuid())
  name         String?
  frequency    TripSeriesFrequency
  /// 0=Sunday..6=Saturday. Ignored when frequency is DAILY.
  daysOfWeek   Int[]               @default([])
  startDate    DateTime            @db.Date
  endDate      DateTime            @db.Date
  isActive     Boolean             @default(true)
  terminatedAt DateTime?           @db.Date
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  trips Trip[]

  @@map("trip_series")
}

/// A single transport job ("vožnja") — distinct from Contract: a trip can be
/// an informal booking with no paperwork, or reference a Contract. Field names
/// are English; the admin UI presents Serbian labels. Vehicles and drivers are
/// many-to-many (one trip regularly runs several buses/drivers, or one driver
/// covers a shift change) via TripVehicle/TripDriver — never a single FK.
model Trip {
  id              String         @id @default(cuid())
  /// "RN broj" — the operator's own trip reference/registration number.
  /// Assigned once invoicing happens, so it's null on most newly-created trips.
  referenceNumber String?
  departureDate   DateTime       @db.Date
  returnDate      DateTime?      @db.Date
  country         String?
  /// Split from a single "Relacija" text field so a dash-separated place
  /// name (e.g. "Novi Sad") can't be misread as two legs of the route.
  origin          String
  destination     String
  passengerCount  Int?
  partnerId       String?
  /// Free-text client name, used when the client isn't a registered Partner.
  clientName      String?
  notes           String?
  price           Float?
  paymentMethod   PaymentMethod?
  status          TripStatus     @default(PLANNED)
  contractId      String?
  /// Distance covered, filled in after the trip — feeds the statistics
  /// endpoint's total-km figure. Not part of the original field list; added
  /// to support Task 3's reporting requirement.
  distanceKm      Float?
  /// Set only on instances generated from a TripSeries.
  seriesId        String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  partner  Partner?      @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  contract Contract?     @relation(fields: [contractId], references: [id], onDelete: SetNull)
  series   TripSeries?   @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  vehicles TripVehicle[]
  drivers  TripDriver[]

  @@index([status])
  @@index([departureDate])
  @@index([country])
  @@index([partnerId])
  @@index([contractId])
  @@index([seriesId])
  @@map("trips")
}

model TripVehicle {
  id        String   @id @default(cuid())
  tripId    String
  vehicleId String
  createdAt DateTime @default(now())

  trip    Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([tripId, vehicleId])
  @@index([vehicleId])
  @@map("trip_vehicles")
}

model TripDriver {
  id        String   @id @default(cuid())
  tripId    String
  driverId  String
  createdAt DateTime @default(now())

  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([tripId, driverId])
  @@index([driverId])
  @@map("trip_drivers")
}
