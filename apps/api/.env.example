# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# ---------------------------------------------------------------------------
# Database (Railway provides this value as ${{ Postgres.DATABASE_URL }})
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:password@localhost:5432/file_admin

# ---------------------------------------------------------------------------
# CORS: comma separated list of allowed browser origins, no trailing slash.
# Wildcards are rejected. Add Vercel preview domains here when you need them.
# Example (production):
#   FRONTEND_URL=https://your-app.vercel.app,https://your-app-git-dev.vercel.app
# ---------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# AWS S3 (private bucket)
# ---------------------------------------------------------------------------
AWS_REGION=eu-central-1
AWS_S3_BUCKET_NAME=your-private-bucket
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# Optional: point the S3 client at an S3-compatible service (MinIO, LocalStack)
# for local testing. Leave both unset for real AWS.
# AWS_S3_ENDPOINT=http://127.0.0.1:9000
# AWS_S3_FORCE_PATH_STYLE=true

# ---------------------------------------------------------------------------
# Presigned URL lifetimes in seconds (maximum 300 = 5 minutes)
# ---------------------------------------------------------------------------
PRESIGNED_UPLOAD_EXPIRES_IN=300
PRESIGNED_DOWNLOAD_EXPIRES_IN=300

# ---------------------------------------------------------------------------
# Upload limits
# ---------------------------------------------------------------------------
MAX_FILE_SIZE_MB=25

# ---------------------------------------------------------------------------
# Rate limiting (optional, values below are the defaults)
# ---------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=300
RATE_LIMIT_MAX_UPLOAD_REQUESTS=60
