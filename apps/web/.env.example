# Base URL of the Express API, including the /api/v1 prefix.
# Local development:
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Production (Vercel): https://your-api.up.railway.app/api/v1

# Optional presentation values shown in the sidebar footer.
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_VERSION=0.1.0

# Optional client-side upload limit in MB. Keep it in sync with the API's
# MAX_FILE_SIZE_MB; the API rejects anything above its own limit regardless.
NEXT_PUBLIC_MAX_FILE_SIZE_MB=25
